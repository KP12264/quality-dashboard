+  /**
+   * readNewest(db, limit) — the newest `limit` records read on the server (orderBy createdAt
+   * desc, limit + 1), ONLY when that gives exactly what the full read above would give;
+   * otherwise null and the caller reads the whole collection as before. Falls back when:
+   *  - fewer than limit + 1 records have createdAt (records without it — counted as 0 by the
+   *    full read — could belong in the result; a query on createdAt never returns them);
+   *  - any returned createdAt is not a finite number (other types sort differently);
+   *  - the record at the cut is not newer than 1 (0 / missing / true would tie with it);
+   *  - two records share the createdAt at the cut (which of them is kept could differ).
+   * The kept records are re-sorted like the full read: createdAt desc, then document id asc.
+   */
+  async function readNewest(db, limit) {
+    const snap = await db.collection(IMPROVEMENT_COLLECTION).orderBy("createdAt", "desc").limit(limit + 1).get();
+    if (snap.size <= limit) return null;
+    const recs = [];
+    snap.forEach(doc => { const r = normalizeImprovement(doc.id, doc.data()); if (r) recs.push(r); });
+    if (recs.length !== snap.size) return null;
+    if (!recs.every(r => typeof r.createdAt === "number" && Number.isFinite(r.createdAt))) return null;
+    if (!(recs[limit - 1].createdAt > 1)) return null;
+    if (recs[limit - 1].createdAt === recs[limit].createdAt) return null;
+    return recs.slice(0, limit).sort((a, b) => (b.createdAt - a.createdAt) || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0));
+  }
+
+  /**
+   * getImprovementById(db, id) → { record } | { record: null, error? }
+   * One document read instead of the whole collection (edit page). An id containing "/" is
+   * not a document of this collection: answered "not found" without reading.
+   */
+  async function getImprovementById(db, id) {
+    if (!db) throw new Error("No Firestore connection available (db is null).");
+    if (typeof id !== "string" || !id || id.includes("/")) return { record: null };
+    try {
+      const doc = await db.collection(IMPROVEMENT_COLLECTION).doc(id).get();
+      return { record: doc.exists ? normalizeImprovement(doc.id, doc.data()) : null };
+    } catch (e) {
+      console.error("Quality Dashboard: failed to read improvement", e);
+      return { record: null, error: e };
+    }
+  }
