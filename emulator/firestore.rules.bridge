rules_version = '2';
// BRIDGE RULES (generated by tools/rules/build-bridge.js — do not edit). TRANSITION ONLY:
// the candidate below + the production snapshot's public Quality Dashboard blocks (unchanged),
// so pages still in sign-in "off" keep working while the new site rolls out. Emulator only.
// =============================================================================
//  COMBINED FIRESTORE RULES CANDIDATE — FOR THE FIREBASE EMULATOR ONLY (Phase 6)
//  Production rules snapshot + Quality Dashboard (Shift Scrap Close)
//
//  DO NOT PUBLISH OR DEPLOY THIS FILE (approval required, see docs/phase6/).
//  * Baseline: emulator/production.firestore.rules.snapshot — the rules copied
//    from the Firebase Console of daily-production-report-46b60 (sha256 in
//    production.firestore.rules.snapshot.meta.json; database and publish time
//    still UNCONFIRMED, item G1).
//  * The Production V2 block below is that snapshot's PV2 + legacy part,
//    unchanged (tests/rules/rules.test.js checks it character by character).
//  * The snapshot's public read/write blocks for scrapLogs, targetMaster,
//    improvements and scrapModelMappings are REPLACED by the Quality Dashboard
//    block (sign-in + roles + ledger). That closes public write — see
//    docs/phase6/compatibility.md. emulator/firestore.rules.bridge keeps them
//    for a zero-downtime transition.
//  * This folder's .firebaserc points at "demo-quality-dashboard", a project
//    that exists only in the emulator.
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== BEGIN Production V2 (verbatim from emulator/production.firestore.rules.snapshot, lines 28-59) =====
    // ── Legacy system — UNCHANGED. Stays exactly as open as it is today so the
    // original site keeps working with no login, forever. Production V2 never
    // writes here (enforced client-side too, in firebase-v2.js).
    match /productionLogs/{doc} {
      allow read, write: if true;
    }

    // ── Production V2 — Dashboard must be viewable by anyone with no login,
    // so all prodV2_* collections are publicly readable. Writing requires the
    // caller to be signed in AND present in the prodV2_authorizedUsers allowlist.
    match /prodV2_authorizedUsers/{email} {
      allow read: if true;
      // Never writable from the app — only an admin editing directly in the
      // Firebase Console (which bypasses these rules) can add/remove entries.
      allow write: if false;
    }

    match /{collection}/{doc}
      // Matches any collection literally named prodV2_* (and its subcollections
      // if any are ever added under a document, e.g. .../subcol/{doc=**}).
      // Explicitly excludes prodV2_authorizedUsers — Firestore rules are OR'd
      // across every matching block, so without this exclusion this generic
      // "allowed employee" rule would override the stricter allow-write:false
      // rule above for that one collection.
      {
      allow read: if collection.matches('prodV2_.*');
      allow write: if collection.matches('prodV2_.*')
        && collection != 'prodV2_authorizedUsers'
        && request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/prodV2_authorizedUsers/$(request.auth.token.email.lower()));
    }
    // ===== END Production V2 =====

    // ===== BEGIN Quality Dashboard =====
    // Same Firebase Auth accounts as Production V2 ("<code>@prodv2.local").
    // Quality Dashboard roles live ONLY in qdUsers/{email}; prodV2_authorizedUsers
    // is never consulted here, and qdUsers is never consulted by the Production V2
    // block above, so a role in one system grants nothing in the other.
    // Read policy: everything the public dashboards read stays publicly readable
    // (Phase 0 decision pending, item G4); qdUsers is never public.

    function qdEmail() {
      return request.auth.token.email.lower();
    }
    function qdSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function qdProfile() {
      return get(/databases/$(database)/documents/qdUsers/$(qdEmail())).data;
    }
    function qdActive() {
      return qdSignedIn()
        && exists(/databases/$(database)/documents/qdUsers/$(qdEmail()))
        && qdProfile().active == true;
    }
    function qdRole(r) {
      return qdActive() && qdProfile().role == r;
    }
    function qdAdmin() {
      return qdRole('admin');
    }
    // Admin: any Line/Shift. Leader: only the slots assigned in qdUsers ("A_DAY", ...).
    function qdCanWriteSlot(line, shift) {
      return qdAdmin() || (qdRole('leader') && (line + '_' + shift) in qdProfile().slots);
    }
    // Dates are Thailand dates (Asia/Bangkok, fixed UTC+7, no daylight saving), like js/config.js
    // (QD_TZ_OFFSET_HOURS). qdBkkNow() is the Thailand wall clock written as if it were UTC, so it
    // compares directly with qdDayStart() (midnight of a "YYYY-MM-DD" date, also written as UTC).
    function qdBkkNow() {
      return request.time + duration.value(7, 'h');
    }
    function qdDayStart(d) {
      return timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10]));
    }
    // Leader date window: Thailand today - date <= qdLeaderWindowDays(). Keep equal to
    // QD_LEADER_EDIT_WINDOW_DAYS in js/config.js (tests/unit checks it). Admins: any date.
    function qdLeaderWindowDays() {
      return 7;
    }
    function qdInWindow(d) {
      return qdAdmin() || qdBkkNow() < qdDayStart(d) + duration.value(qdLeaderWindowDays() + 1, 'd');
    }
    // A date is not in the future (Thailand date <= today).
    function qdNotFuture(d) {
      return qdDayStart(d) <= qdBkkNow();
    }
    // Shift end in MINUTES after the production date's midnight (Thailand time), Door Line,
    // confirmed in Phase 5: DAY 19:50 the same day (1190), NIGHT 08:00 the next day (1920). The
    // NIGHT shift belongs to the date it started on. Keep equal to QD_SHIFT_END in js/config.js
    // (tests/unit checks it). request.time is the server clock: a device clock cannot move it.
    function qdShiftEndMinutes(shift) {
      return shift == 'DAY' ? 1190 : 1920;
    }
    function qdShiftEnded(d, shift) {
      return qdBkkNow() >= qdDayStart(d) + duration.value(qdShiftEndMinutes(shift), 'm');
    }
    function qdValidSlot(line, shift) {
      return line in ['A', 'B', 'C'] && shift in ['DAY', 'NIGHT'];
    }

    function qdValidUser(d) {
      return d.keys().hasOnly(['role', 'active', 'displayName', 'slots', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['role', 'active', 'slots', 'updatedAt', 'updatedBy'])
        && d.role in ['admin', 'leader', 'viewer']
        && d.active is bool
        && d.slots is list && d.slots.size() <= 6
        && d.slots.toSet().difference(['A_DAY', 'A_NIGHT', 'B_DAY', 'B_NIGHT', 'C_DAY', 'C_NIGHT'].toSet()).size() == 0
        && (!('displayName' in d) || (d.displayName is string && d.displayName.size() <= 80))
        && d.updatedBy == qdEmail()
        && d.updatedAt == request.time;
    }
    // Public collections never receive personal data (Phase 7): who did what is kept in the
    // non-public audit events (scrapSlots/{id}/events, "by"). A write may not ADD createdBy /
    // updatedBy; values already on old documents are left exactly as they are.
    // Phase 8 (policy pending G4): also recordedBy (employee code from Excel). It goes to
    // scrapLogPrivate/{logId} instead, which only signed-in QD users can read.
    function qdNoNewPersonal() {
      return request.resource == null
        || (resource == null
              ? !request.resource.data.keys().hasAny(['createdBy', 'updatedBy', 'recordedBy'])
              : request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
                && request.resource.data.get('updatedBy', null) == resource.data.get('updatedBy', null)
                && request.resource.data.get('recordedBy', null) == resource.data.get('recordedBy', null));
    }
    // Improvement action owners (names) are kept in improvementOwners/{id} (not public). A public
    // improvement may have at most 20 actions and none of them may carry an owner.
    function qdNoActionOwner(a, i) {
      return a.size() <= i || !(a[i] is map) || a[i].get('owner', '') == '';
    }
    function qdNoActionOwners() {
      return request.resource == null || !('actions' in request.resource.data)
        || (request.resource.data.actions is list && request.resource.data.actions.size() <= 20
            && qdNoActionOwner(request.resource.data.actions, 0) && qdNoActionOwner(request.resource.data.actions, 1)
            && qdNoActionOwner(request.resource.data.actions, 2) && qdNoActionOwner(request.resource.data.actions, 3)
            && qdNoActionOwner(request.resource.data.actions, 4) && qdNoActionOwner(request.resource.data.actions, 5)
            && qdNoActionOwner(request.resource.data.actions, 6) && qdNoActionOwner(request.resource.data.actions, 7)
            && qdNoActionOwner(request.resource.data.actions, 8) && qdNoActionOwner(request.resource.data.actions, 9)
            && qdNoActionOwner(request.resource.data.actions, 10) && qdNoActionOwner(request.resource.data.actions, 11)
            && qdNoActionOwner(request.resource.data.actions, 12) && qdNoActionOwner(request.resource.data.actions, 13)
            && qdNoActionOwner(request.resource.data.actions, 14) && qdNoActionOwner(request.resource.data.actions, 15)
            && qdNoActionOwner(request.resource.data.actions, 16) && qdNoActionOwner(request.resource.data.actions, 17)
            && qdNoActionOwner(request.resource.data.actions, 18) && qdNoActionOwner(request.resource.data.actions, 19));
    }
    function qdValidScrap(d) {
      return qdValidSlot(d.line, d.shift)
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.model is string && d.model.size() > 0
        && d.defectType is string && d.defectType.size() > 0
        && d.scrapQty is number && d.scrapQty > 0;
    }

    // ---- Roles (Admin only) ----
    match /qdUsers/{email} {
      allow get: if qdAdmin() || (qdSignedIn() && qdEmail() == email);
      allow list: if qdAdmin();
      allow create, update: if qdAdmin() && email == email.lower() && qdValidUser(request.resource.data);
      allow delete: if qdAdmin();
    }

    // ---- Slot ledger (Phase 2) ----
    // One ledger document per production Date + Line + Shift: scrapSlots/{date}_{line}_{shift}.
    // Every scrap-log write must, in the SAME commit (batch / transaction):
    //   * raise that slot's logVersion by exactly 1,
    //   * create the audit event scrapSlots/{slotId}/events/v{new logVersion} that lists
    //     the log id under creates / updates / deletes / movesIn / movesOut,
    //   * keep liveLogCount = previous + creates + movesIn - deletes - movesOut.
    // So any change — even one that leaves the total quantity and the number of logs
    // unchanged — produces a new version and an audit event, or it is refused.
    function qdSlotId(d) {
      return d.date + '_' + d.line + '_' + d.shift;
    }
    function qdSlotPath(slotId) {
      return /databases/$(database)/documents/scrapSlots/$(slotId);
    }
    function qdEventPath(slotId, version) {
      return /databases/$(database)/documents/scrapSlots/$(slotId)/events/$('v' + string(version));
    }
    function qdVersionBefore(slotId) {
      return exists(qdSlotPath(slotId)) ? get(qdSlotPath(slotId)).data.logVersion : 0;
    }
    // The slot moved up exactly one version in this commit and its event lists `logId` in `listName`.
    function qdLedgerRecords(slotId, listName, logId) {
      return existsAfter(qdSlotPath(slotId))
        && getAfter(qdSlotPath(slotId)).data.logVersion == qdVersionBefore(slotId) + 1
        && existsAfter(qdEventPath(slotId, getAfter(qdSlotPath(slotId)).data.logVersion))
        && logId in getAfter(qdEventPath(slotId, getAfter(qdSlotPath(slotId)).data.logVersion)).data[listName];
    }
    function qdEventDelta(e) {
      return e.creates.size() + e.movesIn.size() - e.deletes.size() - e.movesOut.size();
    }

    // ---- Scrap logs ----
    match /scrapLogs/{id} {
      allow read: if true;
      allow create: if qdCanWriteSlot(request.resource.data.line, request.resource.data.shift)
        && qdValidScrap(request.resource.data)
        && qdInWindow(request.resource.data.date)
        && qdNoNewPersonal()
        && qdLedgerRecords(qdSlotId(request.resource.data), 'creates', id);
      // Both the stored Line/Shift/date and the new ones must be the writer's; who created it never changes.
      allow update: if qdCanWriteSlot(resource.data.line, resource.data.shift)
        && qdCanWriteSlot(request.resource.data.line, request.resource.data.shift)
        && qdValidScrap(request.resource.data)
        && qdInWindow(resource.data.date) && qdInWindow(request.resource.data.date)
        && qdNoNewPersonal()
        && (qdSlotId(resource.data) == qdSlotId(request.resource.data)
              ? qdLedgerRecords(qdSlotId(resource.data), 'updates', id)
              : qdLedgerRecords(qdSlotId(resource.data), 'movesOut', id)
                && qdLedgerRecords(qdSlotId(request.resource.data), 'movesIn', id));
      allow delete: if qdCanWriteSlot(resource.data.line, resource.data.shift)
        && qdInWindow(resource.data.date)
        && qdLedgerRecords(qdSlotId(resource.data), 'deletes', id);
    }

    // ---- Slot: ledger + import marker + shift close ----
    // Ledger (Phase 2): logVersion / liveLogCount move only together with events v{n}.
    // Import marker (Phase 3/4): importPending is set (admin) BEFORE an Excel import writes a slot and
    //   cleared (admin) once all of that slot's rows are saved, each change audited as event m{n};
    //   while it is set the slot cannot be closed, so a partly failed import is never confirmed.
    // Public mirror (Phase 4): every slot write also writes scrapCloseSummary/{date} (see above).
    // Close (Phase 3): closeState + snapshot of the current version, with event c{closeRevision}.
    //   Leaders may not re-close a version that is already closed (no duplicates); admins may
    //   reconfirm. Any later scrap write raises logVersion, so the close no longer matches (CHANGED).
    function qdCloseEventPath(slotId, rev) {
      return /databases/$(database)/documents/scrapSlots/$(slotId)/events/$('c' + string(rev));
    }
    function qdValidImportMarker(m) {
      return m is map && m.keys().hasOnly(['importId', 'rows', 'at', 'by'])
        && m.importId is string && m.importId.size() > 0 && m.importId.size() <= 100 && m.rows is int && m.rows > 0
        && m.at == request.time && m.by == qdEmail();
    }
    function qdMarkerEventPath(slotId, rev) {
      return /databases/$(database)/documents/scrapSlots/$(slotId)/events/$('m' + string(rev));
    }
    // Import marker set (old == null) or cleared (new == null), never overwritten; each change is
    // audited as event m{markerRevision}.
    function qdMarkerChangeOk(slotId, old, n) {
      return n.markerRevision == (old == null ? 0 : old.get('markerRevision', 0)) + 1
        && existsAfter(qdMarkerEventPath(slotId, n.markerRevision))
        && ((old == null || old.get('importPending', null) == null)
              ? n.get('importPending', null) != null && qdValidImportMarker(n.importPending)
              : n.get('importPending', null) == null);
    }
    function qdValidMarkerEvent(slotId, eventId, e) {
      return eventId == 'm' + string(getAfter(qdSlotPath(slotId)).data.markerRevision)
        && e.keys().hasOnly(['type', 'action', 'revision', 'importId', 'rows', 'at', 'by'])
        && e.type == 'IMPORT_MARKER'
        && e.revision == getAfter(qdSlotPath(slotId)).data.markerRevision
        && (getAfter(qdSlotPath(slotId)).data.get('importPending', null) != null
              ? e.action == 'SET' && e.importId == getAfter(qdSlotPath(slotId)).data.importPending.importId
                && e.rows == getAfter(qdSlotPath(slotId)).data.importPending.rows
              : e.action == 'CLEAR' && exists(qdSlotPath(slotId))
                && e.importId == get(qdSlotPath(slotId)).data.importPending.importId
                && e.rows == get(qdSlotPath(slotId)).data.importPending.rows);
    }

    // ---- Public, email-free mirror of the close state (Phase 4) ----
    // scrapCloseSummary/{date}.slots["A_DAY"] = qdPublicView(scrapSlots/{date}_A_DAY): every write to
    // a slot must leave its mirror equal to it in the same commit, and the mirror can only be
    // written to the view of the slot as it is after that commit. The public Dashboard / Executive
    // Report read this instead of scrapSlots (which carries employee e-mails and notes).
    function qdSummaryPath(date) {
      return /databases/$(database)/documents/scrapCloseSummary/$(date);
    }
    function qdPublicView(s) {
      return {
        'logVersion': s.logVersion, 'liveLogCount': s.liveLogCount,
        'importPending': s.get('importPending', null) != null,
        'closeState': s.get('closeState', null), 'closedVersion': s.get('closedVersion', null),
        'closeRevision': s.get('closeRevision', 0), 'closedLogCount': s.get('closedLogCount', null),
        'closedScrapQty': s.get('closedScrapQty', null), 'closedFingerprint': s.get('closedFingerprint', null),
        'closedAt': s.get('closedAt', null)
      };
    }
    function qdSummaryOk(n) {
      return existsAfter(qdSummaryPath(n.date))
        && getAfter(qdSummaryPath(n.date)).data.slots.get(n.line + '_' + n.shift, null) == qdPublicView(n);
    }
    function qdSummaryEntryOk(date, old, nw, k, line, shift) {
      return nw.get(k, null) == old.get(k, null)
        || (qdCanWriteSlot(line, shift) && existsAfter(qdSlotPath(date + '_' + k))
            && nw.get(k, null) == qdPublicView(getAfter(qdSlotPath(date + '_' + k)).data));
    }
    function qdSummaryWriteOk(date, old, n) {
      return qdActive()
        && n.keys().hasOnly(['date', 'slots', 'updatedAt'])
        && n.date == date && n.updatedAt == request.time
        && n.slots is map && n.slots.keys().hasOnly(['A_DAY', 'A_NIGHT', 'B_DAY', 'B_NIGHT', 'C_DAY', 'C_NIGHT'])
        && qdSummaryEntryOk(date, old, n.slots, 'A_DAY', 'A', 'DAY')
        && qdSummaryEntryOk(date, old, n.slots, 'A_NIGHT', 'A', 'NIGHT')
        && qdSummaryEntryOk(date, old, n.slots, 'B_DAY', 'B', 'DAY')
        && qdSummaryEntryOk(date, old, n.slots, 'B_NIGHT', 'B', 'NIGHT')
        && qdSummaryEntryOk(date, old, n.slots, 'C_DAY', 'C', 'DAY')
        && qdSummaryEntryOk(date, old, n.slots, 'C_NIGHT', 'C', 'NIGHT');
    }
    match /scrapCloseSummary/{date} {
      allow read: if true;
      allow create: if qdSummaryWriteOk(date, {}, request.resource.data);
      allow update: if qdSummaryWriteOk(date, resource.data.slots, request.resource.data);
      allow delete: if false;
    }
    function qdCloseFieldsOk(slotId, n) {
      return n.closeState in ['SUBMITTED', 'CONFIRMED_ZERO', 'NO_PRODUCTION']
        && n.closedVersion == n.logVersion
        && n.closedLogCount == n.liveLogCount
        && n.closedLogIds is list && n.closedLogIds.size() == n.closedLogCount
        && n.closedScrapQty is number && n.closedScrapQty >= 0
        && n.closedFingerprint is string && n.closedFingerprint.size() > 0
        && (n.closeState == 'SUBMITTED'
              ? n.liveLogCount > 0 && n.closedScrapQty > 0
              : n.liveLogCount == 0 && n.closedScrapQty == 0)
        && (n.closeState == 'NO_PRODUCTION'
              ? n.noProductionReason is string && n.noProductionReason.size() >= 3 && n.noProductionReason.size() <= 200
              : n.noProductionReason == null)
        && (n.closeNote == null || (n.closeNote is string && n.closeNote.size() <= 300))
        && n.get('importPending', null) == null
        && n.closedBy == qdEmail() && n.closedAt == request.time
        && n.updatedBy == qdEmail() && n.updatedAt == request.time
        && qdNotFuture(n.date) && qdInWindow(n.date) && qdShiftEnded(n.date, n.shift)
        && existsAfter(qdCloseEventPath(slotId, n.closeRevision));
    }
    // ---- Ledger baseline (Phase 5 migration) ----
    // Before go-live an Admin creates every slot that already has scrap logs ("baseline": logVersion 0,
    // legacyCount = the logs counted by the migration, audit event b1), then sets
    // qdConfig/ledger.baselineComplete. From then on a slot can only be CREATED with legacyCount 0, so
    // a client can no longer state how many old logs a slot has: that number comes only from the
    // Admin-run, audited baseline. (Status is still always re-checked against the stored logs.)
    function qdBaselineDone() {
      return exists(/databases/$(database)/documents/qdConfig/ledger)
        && get(/databases/$(database)/documents/qdConfig/ledger).data.baselineComplete == true;
    }
    function qdLegacyCountOk(n) {
      return n.legacyCount == 0 || !qdBaselineDone();
    }
    function qdValidBaselineEvent(slotId, eventId, e) {
      return eventId == 'b1'
        && e.keys().hasOnly(['type', 'migrationId', 'legacyCount', 'scrapQty', 'logIds', 'fingerprint', 'at', 'by'])
        && e.type == 'BASELINE'
        && e.migrationId is string && e.migrationId.size() > 0
        && e.legacyCount == getAfter(qdSlotPath(slotId)).data.legacyCount
        && getAfter(qdSlotPath(slotId)).data.logVersion == 0
        && e.logIds is list && e.logIds.size() == e.legacyCount
        && e.scrapQty is number && e.fingerprint is string;
    }
    match /qdConfig/{id} {
      allow read: if qdActive();
      allow write: if qdAdmin() && id == 'ledger'
        && request.resource.data.keys().hasOnly(['baselineComplete', 'migrationId', 'at', 'by'])
        && request.resource.data.baselineComplete is bool
        && request.resource.data.at == request.time && request.resource.data.by == qdEmail();
    }

    function qdSlotBaseKeys() {
      return ['date', 'line', 'shift', 'logVersion', 'liveLogCount', 'legacyCount', 'updatedAt', 'updatedBy'];
    }
    function qdCloseKeys() {
      return ['closeState', 'closedVersion', 'closeRevision', 'closedBy', 'closedAt', 'closedLogCount', 'closedScrapQty',
              'closedLogIds', 'closedFingerprint', 'closeNote', 'noProductionReason', 'updatedAt', 'updatedBy'];
    }

    match /scrapSlots/{slotId} {
      // Ledger and audit trail: signed-in Quality Dashboard users only (they hold employee codes).
      allow read: if qdActive();

      allow create: if qdCanWriteSlot(request.resource.data.line, request.resource.data.shift)
        && qdValidSlot(request.resource.data.line, request.resource.data.shift)
        && slotId == qdSlotId(request.resource.data)
        && request.resource.data.legacyCount is int && request.resource.data.legacyCount >= 0
        && request.resource.data.updatedBy == qdEmail()
        && request.resource.data.updatedAt == request.time
        && qdSummaryOk(request.resource.data)
        && (
          // (a) first ledger write: v1 with its event. legacyCount = logs saved before the ledger
          //     (must be 0 once the baseline is complete).
          (request.resource.data.keys().hasOnly(qdSlotBaseKeys())
            && request.resource.data.logVersion == 1
            && existsAfter(qdEventPath(slotId, 1))
            && request.resource.data.liveLogCount == request.resource.data.legacyCount + qdEventDelta(getAfter(qdEventPath(slotId, 1)).data)
            && request.resource.data.liveLogCount >= 0
            && qdLegacyCountOk(request.resource.data))
          // (b) import marker on a slot without a ledger yet (admin only)
          || (qdAdmin()
            && request.resource.data.keys().hasOnly(qdSlotBaseKeys().concat(['importPending', 'markerRevision']))
            && request.resource.data.logVersion == 0
            && request.resource.data.liveLogCount == request.resource.data.legacyCount
            && qdMarkerChangeOk(slotId, null, request.resource.data)
            && qdLegacyCountOk(request.resource.data))
          // (c) close of a slot without a ledger yet (no scrap written through the ledger)
          || (request.resource.data.keys().hasOnly(qdSlotBaseKeys().concat(qdCloseKeys()))
            && request.resource.data.logVersion == 0
            && request.resource.data.liveLogCount == request.resource.data.legacyCount
            && request.resource.data.closeRevision == 1
            && qdCloseFieldsOk(slotId, request.resource.data)
            && qdLegacyCountOk(request.resource.data))
          // (d) migration baseline (admin only): logs saved before the ledger, audited as event b1
          || (qdAdmin()
            && request.resource.data.keys().hasOnly(qdSlotBaseKeys())
            && request.resource.data.logVersion == 0
            && request.resource.data.liveLogCount == request.resource.data.legacyCount
            && existsAfter(/databases/$(database)/documents/scrapSlots/$(slotId)/events/b1))
        );

      allow update: if qdCanWriteSlot(resource.data.line, resource.data.shift)
        && request.resource.data.updatedBy == qdEmail()
        && request.resource.data.updatedAt == request.time
        && qdSummaryOk(request.resource.data)
        && (
          // (a) ledger write (the import marker is left as it is)
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['logVersion', 'liveLogCount', 'updatedAt', 'updatedBy'])
            && request.resource.data.logVersion == resource.data.logVersion + 1
            && existsAfter(qdEventPath(slotId, request.resource.data.logVersion))
            && (getAfter(qdEventPath(slotId, request.resource.data.logVersion)).data.type == 'RECONCILE'
                  // admin reconcile (Phase 7): the count becomes the attested list of stored logs
                  ? request.resource.data.liveLogCount == getAfter(qdEventPath(slotId, request.resource.data.logVersion)).data.logIds.size()
                  : request.resource.data.liveLogCount == resource.data.liveLogCount + qdEventDelta(getAfter(qdEventPath(slotId, request.resource.data.logVersion)).data))
            && request.resource.data.liveLogCount >= 0)
          // (b) set or clear the import marker (admin only; version unchanged; audited as m{n})
          || (qdAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['importPending', 'markerRevision', 'updatedAt', 'updatedBy'])
            && qdMarkerChangeOk(slotId, resource.data, request.resource.data))
          // (c) close / reconfirm the current version
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(qdCloseKeys())
            && request.resource.data.logVersion == resource.data.logVersion
            && request.resource.data.closeRevision == resource.data.get('closeRevision', 0) + 1
            && (qdAdmin()
                  || resource.data.get('closeState', null) == null
                  || resource.data.get('closedVersion', -1) != resource.data.logVersion)
            && qdCloseFieldsOk(slotId, request.resource.data))
        );
      allow delete: if false;

      // Audit events: v{n} = scrap-log writes (ledger), c{n} = closes, m{n} = import marker set /
      // cleared. Written once, never changed.
      match /events/{eventId} {
        allow read: if qdActive();
        allow create: if existsAfter(qdSlotPath(slotId))
          && qdCanWriteSlot(getAfter(qdSlotPath(slotId)).data.line, getAfter(qdSlotPath(slotId)).data.shift)
          && request.resource.data.by == qdEmail()
          && request.resource.data.at == request.time
          && (eventId.matches('v[0-9]+') ? qdValidLedgerEvent(slotId, eventId, request.resource.data)
              : eventId.matches('c[0-9]+') ? qdValidCloseEvent(slotId, eventId, request.resource.data)
              : eventId.matches('m[0-9]+') ? qdAdmin() && qdValidMarkerEvent(slotId, eventId, request.resource.data)
              : qdAdmin() && !exists(qdSlotPath(slotId)) && qdValidBaselineEvent(slotId, eventId, request.resource.data));
        allow update, delete: if false;
      }
    }
    function qdValidLedgerEvent(slotId, eventId, e) {
      return eventId == 'v' + string(getAfter(qdSlotPath(slotId)).data.logVersion)
        && getAfter(qdSlotPath(slotId)).data.logVersion == qdVersionBefore(slotId) + 1
        && e.version == getAfter(qdSlotPath(slotId)).data.logVersion
        && (e.type == 'RECONCILE' ? qdValidReconcileEvent(e)
            : e.keys().hasOnly(['type', 'version', 'at', 'by', 'creates', 'updates', 'deletes', 'movesIn', 'movesOut', 'changes'])
              && e.type == 'LOG_WRITE'
              && e.creates is list && e.updates is list && e.deletes is list
              && e.movesIn is list && e.movesOut is list && e.changes is list
              && (e.creates.size() + e.updates.size() + e.deletes.size() + e.movesIn.size() + e.movesOut.size()) > 0);
    }
    // Reconcile (Phase 7, Admin only): after the bridge period, a slot whose stored logs no longer
    // match its count (records saved by old pages around the ledger) is re-counted from the logs
    // actually stored. Audited with the full id list, fingerprint, previous count and a reason; it
    // raises logVersion, so a closed shift becomes CHANGED and must be reconfirmed.
    function qdValidReconcileEvent(e) {
      return qdAdmin()
        && e.keys().hasOnly(['type', 'version', 'at', 'by', 'logIds', 'fingerprint', 'scrapQty', 'before', 'reason'])
        && e.logIds is list && e.fingerprint is string && e.scrapQty is number
        && e.before is int && e.reason is string && e.reason.size() >= 3 && e.reason.size() <= 300;
    }
    function qdValidCloseEvent(slotId, eventId, e) {
      return eventId == 'c' + string(getAfter(qdSlotPath(slotId)).data.closeRevision)
        && e.keys().hasOnly(['type', 'revision', 'closeState', 'version', 'logCount', 'scrapQty', 'logIds', 'fingerprint',
                             'note', 'noProductionReason', 'previous', 'at', 'by'])
        && e.type == 'CLOSE'
        && e.revision == getAfter(qdSlotPath(slotId)).data.closeRevision
        && e.closeState == getAfter(qdSlotPath(slotId)).data.closeState
        && e.version == getAfter(qdSlotPath(slotId)).data.closedVersion
        && e.logCount == getAfter(qdSlotPath(slotId)).data.closedLogCount
        && e.scrapQty == getAfter(qdSlotPath(slotId)).data.closedScrapQty
        && e.logIds == getAfter(qdSlotPath(slotId)).data.closedLogIds
        && e.fingerprint == getAfter(qdSlotPath(slotId)).data.closedFingerprint
        && e.note == getAfter(qdSlotPath(slotId)).data.closeNote
        && e.noProductionReason == getAfter(qdSlotPath(slotId)).data.noProductionReason
        && e.previous == qdPreviousClose(slotId);
    }
    // The close this one replaces, taken from the slot BEFORE the write (null for the first close).
    function qdPreviousClose(slotId) {
      return !exists(qdSlotPath(slotId)) || get(qdSlotPath(slotId)).data.get('closeState', null) == null ? null
        : { 'state': get(qdSlotPath(slotId)).data.closeState, 'version': get(qdSlotPath(slotId)).data.closedVersion,
            'revision': get(qdSlotPath(slotId)).data.closeRevision, 'by': get(qdSlotPath(slotId)).data.closedBy };
    }

    // ---- Other Quality Dashboard collections ----
    match /targetMaster/{id} {
      allow read: if true;
      allow write: if qdAdmin() && qdNoNewPersonal();
    }
    match /improvements/{id} {
      allow read: if true;
      allow write: if qdAdmin() && qdNoNewPersonal() && qdNoActionOwners();          // Leader / Viewer: read-only
    }

    // ---- Personal data, NOT public (Phase 8; policy pending G4) ----
    // Who recorded an imported scrap record (Excel "Emp. Ld"): one doc per scrap log, written with the
    // log in the same commit, readable by signed-in QD users only.
    function qdLogPath(id) {
      return /databases/$(database)/documents/scrapLogs/$(id);
    }
    match /scrapLogPrivate/{id} {
      allow read: if qdActive();
      allow create, update: if existsAfter(qdLogPath(id))
        && qdCanWriteSlot(getAfter(qdLogPath(id)).data.line, getAfter(qdLogPath(id)).data.shift)
        && request.resource.data.keys().hasOnly(['recordedBy'])
        && request.resource.data.recordedBy is string && request.resource.data.recordedBy.size() <= 64;
      // removed together with its scrap log (or by an admin)
      allow delete: if qdAdmin()
        || (exists(qdLogPath(id)) && !existsAfter(qdLogPath(id))
            && qdCanWriteSlot(get(qdLogPath(id)).data.line, get(qdLogPath(id)).data.shift));
    }
    // Operations log (Phase 8): one immutable record per write step run from the Admin page's
    // Operations tab (reconcile, baseline, gate) — who, when, approval reference, result.
    match /qdOpsLog/{id} {
      allow read: if qdAdmin();
      allow create: if qdAdmin()
        && request.resource.data.keys().hasOnly(['action', 'projectId', 'database', 'approvalRef', 'reason', 'summary', 'at', 'by'])
        && request.resource.data.action in ['RECONCILE', 'BASELINE_APPLY', 'BASELINE_GATE', 'CLEAR_IMPORT_MARKER']
        && request.resource.data.approvalRef is string && request.resource.data.approvalRef.size() >= 3
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 3
        && request.resource.data.at == request.time && request.resource.data.by == qdEmail();
      allow update, delete: if false;
    }
    // Improvement action owners: owners[i] belongs to actions[i] of improvements/{id}.
    match /improvementOwners/{id} {
      allow read: if qdActive();
      allow write: if qdAdmin()
        && (request.resource == null
            || (request.resource.data.keys().hasOnly(['owners', 'updatedAt'])
                && request.resource.data.owners is list && request.resource.data.owners.size() <= 20));
    }
    match /scrapModelMappings/{id} {
      allow read: if true;
      allow write: if qdAdmin() && qdNoNewPersonal();
    }
    match /scrapWeeklyPlans/{id} {
      allow read: if true;
      allow write: if qdAdmin() && qdNoNewPersonal();          // Leader / Viewer: read-only
    }
    // ===== END Quality Dashboard =====

    // ===== BEGIN bridge: copied unchanged from emulator/production.firestore.rules.snapshot =====
    // ── Quality Dashboard (separate app: scrap tracking, targets,
    // improvements) — public read/write, same openness as productionLogs
    // above, for the same reason: no login system built for this app yet.
    // PIN/employee-login for this app is a planned later phase.
    match /scrapLogs/{doc} {
      allow read, write: if true;
    }
    match /targetMaster/{doc} {
      allow read, write: if true;
    }
    match /improvements/{doc} {
      allow read, write: if true;
    }

    match /scrapModelMappings/{doc} {
      allow read, write: if true;
    }
    // ===== END bridge =====

    // ── Everything else — default deny. (from production-v2/firestore.rules)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
